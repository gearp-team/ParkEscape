<?xml version="1.0" encoding="utf-8"?>
<!--
    debug 빌드 전용 확인 화면. release에는 들어가지 않는다. 퍼미션은 본 매니페스트에 있다.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            distractionOptimized를 일부러 선언하지 않는다(주행 중 시스템 차단 화면 동작을 재기 위해).
            실행: adb shell am start -n com.team.pleosapp/.spike.SpikeActivity
        -->
        <activity
            android:name=".spike.SpikeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="com.team.pleosapp.spike" />
        <!--
            F2-data 확인 화면: 새 Repository 4종의 지원 범위·현재값·Flow를 logcat 태그 DATA로 남긴다.
            실행: adb shell am start -n com.team.pleosapp/.spike.DataCheckActivity
        -->
        <activity
            android:name=".spike.DataCheckActivity"
            android:exported="true"
            android:taskAffinity="com.team.pleosapp.datacheck" />
    </application>
</manifest>
